<UserControl x:Class="FileExplorer.App.Features.DiskUsage.DiskUsageTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:du="clr-namespace:FileExplorer.App.Features.DiskUsage">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <du:FractionToWidth x:Key="FractionToWidth"/>
        <du:HexToBrush x:Key="HexToBrush"/>
        <ContextMenu x:Key="NodeMenu">
            <MenuItem Header="Open" Click="Menu_Open"/>
            <MenuItem Header="Reveal in Explorer" Click="Menu_Reveal"/>
            <MenuItem Header="Copy path" Click="Menu_CopyPath"/>
            <MenuItem Header="Properties" Click="Menu_Properties"/>
            <Separator/>
            <MenuItem Header="Delete (Recycle Bin)" Click="Menu_Delete"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton Content="Logical" GroupName="mode" IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                    <RadioButton Content="On disk" GroupName="mode" IsChecked="{Binding AllocatedMode}" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"
                                 ToolTip="Allocated size: each file rounded up to whole clusters"/>
                    <Button Content="Choose…" Command="{Binding ChooseFolderCommand}"/>
                    <Button Content="Rescan" Command="{Binding StartScanCommand}"/>
                    <Button Content="Cancel" Command="{Binding CancelScanCommand}" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RootPath}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Style="{x:Null}" CornerRadius="10" Padding="9,2" Margin="0,0,6,0" BorderThickness="1" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Line}">
                        <TextBlock Text="{Binding ScanChip}" FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                    </Border>
                    <Border CornerRadius="10" Padding="9,2" Margin="0,0,6,0" BorderThickness="1" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Line}">
                        <TextBlock Text="{Binding UsedChip}" FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                    </Border>
                    <Border CornerRadius="10" Padding="9,2" Margin="0,0,6,0" BorderThickness="1" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Line}">
                        <TextBlock Text="Enumerated scan (sizes read per file)" FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                    </Border>
                    <Button Content="{Binding WarningChip}" Command="{Binding ShowWarningsCommand}" FontSize="11.5" Foreground="{DynamicResource Danger}"
                            Visibility="{Binding WarningChip.Length, Converter={StaticResource CountVis}}" MinHeight="22"/>
                    <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="54*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- folder tree -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{DynamicResource Panel}" Margin="0,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="76"/><ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Folder" Margin="32,6,0,6" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Grid.Column="1" Text="% of total" Margin="6,6,0,6" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Grid.Column="2" Text="Size" HorizontalAlignment="Right" Margin="0,6,6,6" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Grid.Column="3" Text="Files" HorizontalAlignment="Right" Margin="0,6,4,6" Foreground="{DynamicResource Muted}"/>
                </Grid>
                <TreeView x:Name="Tree" Grid.Row="1" ItemsSource="{Binding TopNodes}" Background="{DynamicResource Panel}" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ContextMenu="{StaticResource NodeMenu}"
                          Foreground="{DynamicResource Fg}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid MinWidth="360">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="76"/><ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,7,0" Background="{Binding BrushHex, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Border Width="52" Height="8" Background="{DynamicResource Panel2}" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center" ClipToBounds="True">
                                        <Border HorizontalAlignment="Left" Height="8" CornerRadius="2" Background="{Binding BrushHex, Converter={StaticResource HexToBrush}}"
                                                Width="{Binding Fraction, Converter={StaticResource FractionToWidth}, ConverterParameter=52}"/>
                                    </Border>
                                    <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding FilesText}" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="{DynamicResource Muted}"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource Panel2}"/>

            <!-- treemap, legend, extension table -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Margin="10" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3">
                    <du:TreemapControl x:Name="Map"/>
                </Border>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Legend}" Margin="12,0,12,8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                                <TextBlock FontSize="12"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SizeText, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ListView Grid.Row="2" ItemsSource="{Binding Extensions}" SelectedItem="{Binding SelectedExtension}" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Extension" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                                            <TextBlock Text="{Binding Extension}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding GroupName}"/>
                            <GridViewColumn Header="Files" Width="80" DisplayMemberBinding="{Binding Files}"/>
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="%" Width="60" DisplayMemberBinding="{Binding PercentText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="12,4" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Zoom out" Click="ZoomOut_Click" MinHeight="22" Padding="8,0" ToolTip="Treemap: double-click a folder to zoom in"/>
                <TextBlock Text="{Binding SelectionText}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
