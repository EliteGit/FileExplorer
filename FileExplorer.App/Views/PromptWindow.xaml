<Window x:Class="FileExplorer.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource Panel}">
    <StackPanel Margin="16">
        <TextBlock x:Name="Label" Margin="0,0,0,6"/>
        <TextBox x:Name="Input"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" MinWidth="72" Focusable="True"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="72" Margin="8,0,0,0" Focusable="True"/>
        </StackPanel>
    </StackPanel>
</Window>
